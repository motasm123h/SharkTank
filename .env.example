# Copy to .env and adjust. Never commit .env.
# In development every value has a working default, so .env is optional.

# --- Database (Postgres container) ---
POSTGRES_USER=panel
# Required in production. Use a long random value.
POSTGRES_PASSWORD=panel
POSTGRES_DB=panel
# Built automatically from the values above inside Docker. Only set this when
# running tools outside Docker (e.g. connecting to localhost:5432).
# DATABASE_URL=postgres://panel:panel@localhost:5432/panel

# --- AI (Phase 7) ---
# "mock" runs pre-written sessions and needs no key.
AI_PROVIDER=mock
# Model id for the real provider, e.g. claude-sonnet-5-5. Unused with mock.
AI_MODEL=
# API key for the real provider. Unused with mock.
AI_API_KEY=

# --- Security ---
# Signs short-lived links used for PDF rendering. Required in production
# (32+ random characters, e.g. `openssl rand -base64 48`). Optional in development.
APP_SECRET=

# --- PDF export (Gotenberg) ---
# Both have working defaults inside Docker; change only for a custom setup.
# GOTENBERG_URL=http://gotenberg:3000
# INTERNAL_APP_URL=http://web:3000
