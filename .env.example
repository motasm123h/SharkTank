# Copy to .env and adjust. Never commit .env.
# In development every value has a working default, so .env is optional.

# --- Database (Postgres container) ---
POSTGRES_USER=panel
# Required in production. Use a long random value.
POSTGRES_PASSWORD=panel
POSTGRES_DB=panel
# Built automatically from the values above inside Docker. Only set this when
# running tools outside Docker (e.g. connecting to localhost:5432).
# DATABASE_URL=postgres://panel:panel@localhost:5432/panel

# --- AI ---
# "mock" runs pre-written demo sessions and needs no key.
# "google" uses Gemini (free key: https://aistudio.google.com/apikey).
# "openrouter" uses OpenRouter (https://openrouter.ai/keys).
AI_PROVIDER=mock
# Key for AI_PROVIDER. Never commit it.
AI_API_KEY=
# Optional fallback chain, tried in order when a model is busy or out of quota.
# Entries without a prefix use AI_PROVIDER; add other providers with a prefix,
# e.g. gemini-3.5-flash,gemini-3.5-flash-lite,openrouter:meta-llama/llama-3.3-70b-instruct:free
# Empty = sensible defaults for the provider.
AI_MODEL=
# Optional separate chain for the report (bigger, slower call). Empty = defaults.
AI_REPORT_MODEL=
# Needed only if the chain includes openrouter: models.
OPENROUTER_API_KEY=
# Web search for competitors and sourced facts (Gemini Google Search).
# Not included in the Gemini free tier as of October 2026: keep "off" unless billing is on.
AI_SEARCH=off
# Real sessions allowed per day (UTC), to protect free quotas.
AI_DAILY_SESSION_LIMIT=30

# --- Security ---
# Signs short-lived links used for PDF rendering. Required in production
# (32+ random characters, e.g. `openssl rand -base64 48`). Optional in development.
APP_SECRET=

# --- PDF export (Gotenberg) ---
# Both have working defaults inside Docker; change only for a custom setup.
# GOTENBERG_URL=http://gotenberg:3000
# INTERNAL_APP_URL=http://web:3000
